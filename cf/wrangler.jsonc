{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zec-frost",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  // No request logs: the server must not keep IP addresses or timing.
  "observability": { "enabled": false },
  "preview_urls": false,
  // The Solana beta: "1" serves web/sol (ZOLANA.md). The Helius Devnet URL is the secret
  // HELIUS_DEVNET_URL: set it with `wrangler secret put`, never here.
  "vars": { "SOL": "1" },
  "routes": [{ "pattern": "app.zigs.app", "custom_domain": true }],
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // New group connections per IP and minute, counted per Cloudflare location (approximate).
  "ratelimits": [{ "name": "WS_PER_IP", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // The staging copy (VEL-2): its own Worker, Durable Object data, password and rate counter, at
  // staging.zigs.app. scripts/deploy-staging.sh deploys main to it. The keys below are not
  // inherited from the top level; the others are.
  "env": {
    "staging": {
      "name": "zec-frost-staging",
      "vars": { "SOL": "1" },
      "routes": [{ "pattern": "staging.zigs.app", "custom_domain": true }],
      "ratelimits": [
        { "name": "WS_PER_IP", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [{ "name": "STORE", "class_name": "Store" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
    }
  }
}
