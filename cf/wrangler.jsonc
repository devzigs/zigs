{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zec-frost",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.zigs.app", "custom_domain": true }],
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/ws"]
  },
  // New group connections per IP and minute, counted per Cloudflare location (approximate).
  "ratelimits": [{ "name": "WS_PER_IP", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
