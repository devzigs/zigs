{
  "$schema": "../cf/node_modules/wrangler/config-schema.json",
  "name": "zigs-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "zigs-waitlist", "database_id": "eaccbc8e-e20a-4e2f-b845-64f081b53278", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "zigs.app", "custom_domain": true }]
}
