#!/bin/sh
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  python3 scripts/check-web-scope.py --commit "$local_sha" --ref "$remote_ref"
  if [ "$remote_sha" = 0000000000000000000000000000000000000000 ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$(git merge-base "$local_sha" refs/remotes/origin/main)
  else
    base=$remote_sha
  fi
  # A UI branch rebuilt on main must not re-audit unchanged upstream authors.
  if ! git merge-base --is-ancestor "$base" "$local_sha"; then
    base=$(git merge-base "$local_sha" refs/remotes/origin/main)
  fi
  python3 scripts/check-git-identity.py --commits "$base..$local_sha"
done
